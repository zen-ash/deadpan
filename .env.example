# Copy to .env and fill in. Never commit .env.
# On Render, set these as environment variables instead.

# Local dev port. Render sets PORT itself.
PORT=3000

# Google AI Studio (aistudio.google.com), with billing on. Needed from M3.
GEMINI_API_KEY=

# ElevenLabs API key and the detective's voice ID. Needed from M2 (Scribe) and M3 (voice).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Tiger Cloud Postgres connection string. Needed from M5.
DATABASE_URL=

# Copy to .env and fill in. Never commit .env.
# On Render, set these as environment variables instead.

# Local dev port. Render sets PORT itself.
PORT=3000

# Google AI Studio (aistudio.google.com), with billing on. Needed from M3.
GEMINI_API_KEY=

# ElevenLabs API key and the detective's voice ID. Needed from M2 (Scribe) and M3 (voice).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Opens /admin: every saved round and the accuracy stat. Make up a long random value.
ADMIN_KEY=

# Where round recordings and rounds.jsonl go. Defaults to rounds/ in the repo; Render points it
# at its persistent disk.
# ROUNDS_DIR=
